# Telegram bot token (получить у @BotFather)
BOT_TOKEN=

# Telegram ID владельца (Владимира). Используется в конфигурации проекта.
# ВНИМАНИЕ: сам по себе доступ к панели НЕ открывает — allowlist задаётся
# отдельно через TELEGRAM_ALLOWED_USER_IDS.
ADMIN_TELEGRAM_ID=

# Разрешённые Telegram user_id (allowlist) через запятую — единственный источник
# доступа к панели. Политика fail-closed: если переменная отсутствует, пуста или
# некорректна — доступ закрыт для всех, включая владельца.
# Пример: TELEGRAM_ALLOWED_USER_IDS=586249067
TELEGRAM_ALLOWED_USER_IDS=

# Путь к SQLite-журналу (относительно корня проекта)
JOURNAL_DB_PATH=data/journal.sqlite3

# Рабочий файл реестра источников. Необязателен: по умолчанию data/sources.json.
# При первом запуске разворачивается из стартового набора config/sources.json,
# дальше живёт своей жизнью. В Git не отслеживается и деплоем не переносится,
# поэтому обновление кода не стирает источники, добавленные через бота.
# Стартовый набор при этом не меняется — он остаётся частью поставки.
# SOURCE_REGISTRY_PATH=data/sources.json

# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Новое task-oriented меню. Безопасное значение по умолчанию — false.
TA_CONTROL_CENTER_V2_MENU_ENABLED=false

# LLM-провайдер Оркестратора. Поддерживается: openai.
# Если переменная не задана или пуста — используется openai, поведение
# существующей установки не меняется. Неизвестное значение приводит к
# понятной ошибке при старте.
# Будущий yandex подключается отдельным адаптером и потребует своих
# переменных (каталог и ключ) — сейчас они не нужны.
LLM_PROVIDER=openai

# Настройки провайдера openai. Ключ вендора живёт не здесь: TA Control Center
# обращается к модели через внутренний API Travel Content Factory на том же VPS.
# Внутренний URL Travel Content Factory на этом же VPS.
# Пример: http://127.0.0.1:8010/internal/generate
CONTENT_FACTORY_INTERNAL_URL=

# Необязательный отдельный endpoint анализа источника. Если пусто, адрес
# выводится из CONTENT_FACTORY_INTERNAL_URL, оканчивающегося на /internal/generate.
CONTENT_FACTORY_SOURCE_ANALYSIS_URL=

# Необязательный отдельный endpoint структурированных тем поста (F2D). Если
# пусто, адрес выводится из CONTENT_FACTORY_INTERNAL_URL так же, как для
# CONTENT_FACTORY_SOURCE_ANALYSIS_URL выше (.../internal/propose-topics).
CONTENT_FACTORY_TOPICS_URL=

# Внутренний токен Travel Content Factory.
# НЕ публиковать, НЕ логировать, НЕ коммитить настоящее значение.
CONTENT_FACTORY_INTERNAL_TOKEN=

# Таймаут сетевого вызова Content Factory, секунды (по умолчанию 20).
CONTENT_FACTORY_TIMEOUT_SECONDS=20

# LLM-провайдер Phase 1 orchestration shadow mode (app/orchestration).
# Поддерживается: null (по умолчанию, полностью инертно - никакого сетевого
# вызова, только старый keyword/regex router) и openai (первый живой
# провайдер - прямой HTTPS-вызов OpenAI, см. app/orchestration/openai_provider.py).
# Не влияет на маршрутизацию ответа пользователю ни при каком значении -
# только на то, логируется ли параллельное сравнение со старым роутером.
ORCHESTRATION_LLM_PROVIDER=null

# Настройки провайдера openai для ORCHESTRATION_LLM_PROVIDER. Отдельный ключ
# от CONTENT_FACTORY_* выше: это прямой вызов OpenAI из этого процесса, а не
# через внутренний API Travel Content Factory.
# НЕ публиковать, НЕ логировать, НЕ коммитить настоящее значение.
ORCHESTRATION_OPENAI_API_KEY=

# Модель OpenAI для shadow-классификатора (по умолчанию gpt-4o-mini).
ORCHESTRATION_OPENAI_MODEL=gpt-4o-mini

# Таймаут вызова OpenAI для shadow-классификатора, секунды (по умолчанию 10).
ORCHESTRATION_OPENAI_TIMEOUT_SECONDS=10

# Путь к локальной SQLite-базе Travel Lead Radar на этом же VPS.
# TA Control Center читает leads.db напрямую (только чтение, без HTTP-сервиса).
# Файл action_recommender.py подгружается по пути, выведенному из этого:
#   <LEAD_RADAR_DB_PATH>/../../app/ai/action_recommender.py
LEAD_RADAR_DB_PATH=/opt/travel_lead_radar/data/leads.db

# Stage 3 Planner MVP (app/planner) - master switch, по умолчанию выключен.
# Пока false (или PLANNER_LLM_PROVIDER=null/не сконфигурирован, или
# пользователь не в PLANNER_ALLOWED_TELEGRAM_USER_IDS) поведение бота 100%
# идентично отсутствию Planner - работает только старый keyword/regex router.
PLANNER_ENABLED=false

# LLM-провайдер Planner. Поддерживается: null (по умолчанию, полностью
# инертно) и openai (прямой HTTPS-вызов, см. app/planner/openai_provider.py).
PLANNER_LLM_PROVIDER=null

# Настройки провайдера openai для PLANNER_LLM_PROVIDER. Если не задано,
# используется ORCHESTRATION_OPENAI_API_KEY (тот же вендорский ключ, без
# дублирования секрета) - задавайте отдельно, только если Planner должен
# использовать другой ключ/аккаунт, чем shadow-классификатор.
# НЕ публиковать, НЕ логировать, НЕ коммитить настоящее значение.
PLANNER_OPENAI_API_KEY=

# Модель OpenAI для Planner (по умолчанию gpt-4o-mini).
PLANNER_OPENAI_MODEL=gpt-4o-mini

# Таймаут вызова OpenAI для Planner, секунды (по умолчанию 20 - план и
# синтез сложнее одноразовой классификации маршрута).
PLANNER_OPENAI_TIMEOUT_SECONDS=20

# Staged rollout allowlist: Telegram user_id через запятую, которым разрешён
# Planner, даже если PLANNER_ENABLED=true и провайдер сконфигурирован.
# Политика fail-closed, как у TELEGRAM_ALLOWED_USER_IDS: пустое/отсутствующее
# значение = Planner недоступен НИКОМУ, а не "без ограничений".
# Первый staged-запуск: указать здесь только свой собственный Telegram id.
PLANNER_ALLOWED_TELEGRAM_USER_IDS=

# Stage 3.1: жёсткий предел платных LLM-вызовов на один запуск Planner
# (1 вызов на построение плана + по одному на каждый LLM-исполняющий шаг +
# опциональный финальный synthesis). Значение по умолчанию (4) уже
# гарантированно покрывает типичный сценарий (обычно 2). Некорректное,
# отсутствующее или вне диапазона [1, 7] значение — тихий откат к 4, старт
# никогда не падает из-за этой переменной.
PLANNER_MAX_LLM_CALLS=4

# Web search MVP (см. app/services/web_search) - для Web Assistant (/api/chat)
# ТОЛЬКО. Telegram эту фичу пока не использует. По умолчанию выключено:
# существующее поведение /api/chat не меняется, пока не заданы и
# WEB_SEARCH_ENABLED=true, и реальные YANDEX_SEARCH_* credentials ниже.
WEB_SEARCH_ENABLED=false

# Единственный поддерживаемый провайдер сейчас. Неизвестное значение или
# отсутствующие credentials ниже - fail-soft (веб-поиск просто выключен),
# приложение не падает.
WEB_SEARCH_PROVIDER=yandex

# Yandex Web Search API v2 (aistudio.yandex.ru/docs/en/search-api/) - НЕ
# устаревший XML/v1 API. Ключ и Folder ID берутся в Yandex AI Studio
# (Create API key / иконка рядом с именем каталога).
# НЕ публиковать, НЕ логировать, НЕ коммитить настоящее значение.
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=

# Таймаут запроса к Yandex Search API, секунды (по умолчанию 5 - веб-поиск
# не должен заметно замедлять ответ Ассистента; при таймауте Assistant
# просто отвечает без результатов поиска, см. app/services/web_search).
YANDEX_SEARCH_TIMEOUT_SECONDS=5

# Максимум результатов поиска на один запрос (по умолчанию 5).
YANDEX_SEARCH_MAX_RESULTS=5
